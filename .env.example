# Copia este archivo a api/.env (o exporta las variables). Valores SOLO para desarrollo local.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Rol de la aplicación (permisos mínimos)
DATABASE_URL=postgres://treo_app:treo_app_dev@localhost:5433/treo
# Rol dueño del esquema: migraciones
DATABASE_MIGRATION_URL=postgres://treo_owner:treo_owner_dev@localhost:5433/treo
DB_POOL_MAX=20
LOCK_TIMEOUT_MS=5000

# Pruebas de integración (base separada que se reinicia en cada corrida)
TEST_DATABASE_URL=postgres://treo_app:treo_app_dev@localhost:5433/treo_test
TEST_DATABASE_MIGRATION_URL=postgres://treo_owner:treo_owner_dev@localhost:5433/treo_test

# Genera valores propios con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-local-dev-only-jwt-secret-at-least-32-chars
OTP_PEPPER=change-me-local-dev-only-otp-pepper-at-least-32-chars
JWT_ISSUER=treo-wallet-api
JWT_AUDIENCE=treo-wallet-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true

# Reglas de negocio (centavos)
DEFAULT_DAILY_LIMIT_CENTS=5000000
OTP_THRESHOLD_CENTS=1000000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
BUSINESS_TIMEZONE=America/Mexico_City
# 3 dígitos de banco + 3 de plaza para las CLABEs internas (ficticios)
CLABE_PREFIX=999180

# Seguridad HTTP
CORS_ORIGINS=http://localhost:5173
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
