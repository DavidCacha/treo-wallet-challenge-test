{
  "name": "@treo/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.62.7",
    "expo": "~58.0.23",
    "expo-crypto": "~58.0.7",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "zod": "~3.23.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:live": "jest -c jest.live.config.js --runInBand"
  },
  "private": true,
  "description": "App móvil Treo (Expo + React Native)",
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@treo/shared$": "<rootDir>/../packages/shared/src/index.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.live\\.test\\.ts$"
    ],
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ]
  }
}
